# Copy to .env on the server (same folder as docker-compose.yml) and fill in.
# Never commit the real .env.

# ---- Domains (DNS A records must point to the server) ----
API_DOMAIN=api.wheellol.com
SOCKET_DOMAIN=socket.wheellol.com
ADMIN_DOMAIN=admin.wheellol.com
ACME_EMAIL=you@example.com

# ---- Database (runs in Docker; DATABASE_URL is built from these) ----
POSTGRES_USER=wheellol
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=wheellol

# ---- Backend secrets ----
# NOTE: the code reads JWT_SECRET (the old local .env spelled it JWT_SECRETE,
# so the code fell back to "yourSecret"). Use a long random value here.
JWT_SECRET=change-me-long-random
DO_SPACES_KEY=
DO_SPACES_SECRET=
CHAPA_SECRET_KEY=
AFRO_MESSAGE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
API_BASE_URL=https://api.wheellol.com

# Set to false to skip `prisma migrate deploy` on container start
RUN_MIGRATIONS=true

# ---- Filled in by the deploy workflow; leave as-is ----
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>-backend
# ADMIN_IMAGE=ghcr.io/<owner>/<repo>-admin
# IMAGE_TAG=latest
