# /opt/wheellol/.env on the server. deploy.sh creates it on the first run by
# IMPORTING your existing production backend .env, so you normally never
# write this by hand. Never commit the real .env.

# ---- Deploy settings ----
ADMIN_DOMAIN=wheellol.com
API_DOMAIN=api.wheellol.com
SOCKET_DOMAIN=socket.wheellol.com
ACME_EMAIL=admin@wheellol.com
ADMIN_PORT=8080
BACKEND_IMAGE=ghcr.io/marshalyordanos/afridata_wheellol-backend
ADMIN_IMAGE=ghcr.io/marshalyordanos/afridata_wheellol-admin
# empty = use your existing Postgres/Redis; "db,redis" = bundled ones (fresh server)
COMPOSE_PROFILES=
RUN_MIGRATIONS=true

# ---- App settings (same as the backend's .env) ----
# Existing Postgres on the same server works as-is (backend uses host network)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wheellol"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/wheellol"
REDIS_URL=redis://localhost:6379
# The code reads JWT_SECRET (old .env had JWT_SECRETE -> fallback "yourSecret")
JWT_SECRET=change-me-long-random
DO_SPACES_KEY=
DO_SPACES_SECRET=
CHAPA_SECRET_KEY=
AFRO_MESSAGE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
API_BASE_URL=https://api.wheellol.com

# Only with COMPOSE_PROFILES=db (bundled Postgres)
# POSTGRES_USER=wheellol
# POSTGRES_PASSWORD=
# POSTGRES_DB=wheellol
